# ── База данных ───────────────────────────────────────────────────────────────
# Пусто → локальный PGlite (Postgres в WASM, данные в ./.data/pglite).
# Для продакшена укажите строку подключения к PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/irbis_mart?sslmode=require"

# ── Приложение ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Ирбис Март"

# ── Аутентификация ────────────────────────────────────────────────────────────
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET="change-me-please-to-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL_MIN="30"
REFRESH_TOKEN_TTL_DAYS="30"

# ── Платежи ЮKassa ────────────────────────────────────────────────────────────
# Если не заполнено, используется демо-касса (оплата имитируется).
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_RETURN_URL="http://localhost:3000/checkout/success"
# true — разрешить демо-оплату (только локально/демо). В проде с ЮKassa не нужно.
DEMO_PAYMENTS="true"

# ── Доставка и магазин ────────────────────────────────────────────────────────
NEXT_PUBLIC_DELIVERY_ENABLED="true"
NEXT_PUBLIC_PICKUP_ADDRESS="с. Новая Тура, ул. Совхозная, 1"
NEXT_PUBLIC_SHOP_PHONE="+7 (843) 200-00-00"
NEXT_PUBLIC_SHOP_EMAIL="hello@irbis-mart.ru"
NEXT_PUBLIC_SHOP_HOURS="Ежедневно 08:00–23:00"
NEXT_PUBLIC_CAFE_HOURS="Ежедневно 08:00–22:00"

# ── Карты ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""
NEXT_PUBLIC_SHOP_COORDS="55.862057,48.834461"

# ── Аналитика ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_YM_ID=""
NEXT_PUBLIC_GA_ID=""

# ── Уведомления ───────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Ирбис Март <hello@irbis-mart.ru>"
SMSRU_API_ID=""

# ── Служебное ─────────────────────────────────────────────────────────────────
CRON_SECRET="change-me-cron-secret"
